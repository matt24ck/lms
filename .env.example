# ─────────────────────────────────────────────────────────────
# Database — Supabase Postgres
# Project settings → Database → Connection string
# ─────────────────────────────────────────────────────────────

# Runtime connection. Use the *pooled* string (Transaction pooler, port 6543)
# so serverless functions don't exhaust Postgres connections.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations only. Use the *direct* connection (port 5432) — the pooler cannot
# run migrations. Read by prisma.config.ts, never by the app.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# Auth.js v5
# ─────────────────────────────────────────────────────────────

# Signs session cookies. Generate with: npx auth secret
AUTH_SECRET=""

# Discord Developer Portal → your application → OAuth2.
# Add these redirect URLs there:
#   http://localhost:3000/api/auth/callback/discord
#   https://<your-domain>/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Comma-separated emails promoted to admin on sign-in. This bootstraps the
# first admin without a manual SQL update. It only ever grants the flag —
# removing an address here does not demote anyone.
ADMIN_EMAILS=""

# ─────────────────────────────────────────────────────────────
# Fixtures — football-data.org
# Free API token: https://www.football-data.org/client/register
# Free tier allows 10 requests/minute, which is plenty here.
# ─────────────────────────────────────────────────────────────

FOOTBALL_DATA_API_KEY=""
